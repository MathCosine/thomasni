# Copy this file to ".env" and fill in real values before running.

# Password for the admin / author dashboard (the "scroll-down" writing area).
ADMIN_PASSWORD=change-me-please

# Long random string used to sign the admin session cookie.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=replace-with-a-long-random-secret

# Public base URL of the site (used for the RSS feed and canonical links).
SITE_URL=http://localhost:3000
