# Copy this file to ".env" for local development if you want to override defaults.
# In CI (GitHub Pages), SITE_URL and the base path are set automatically by the
# deploy workflow — you do not need this file there.

# Absolute base URL of the site (used by the RSS feed and metadata).
SITE_URL=http://localhost:3000

# Comments + reactions via Giscus (https://giscus.app). You can either paste
# these values directly into src/config.ts, set them here, or add them as
# repository Variables (GISCUS_REPO, GISCUS_REPO_ID, ...) for the workflow.
# NEXT_PUBLIC_GISCUS_REPO=owner/repo
# NEXT_PUBLIC_GISCUS_REPO_ID=
# NEXT_PUBLIC_GISCUS_CATEGORY=Announcements
# NEXT_PUBLIC_GISCUS_CATEGORY_ID=
